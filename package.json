{
  "name": "family-medical-vault",
  "version": "0.0.0",
  "private": true,
  "description": "Private medical records vault for individuals and authorized family caregivers",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.33.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "pnpm --filter @fmv/server dev",
    "test": "pnpm test:infra && pnpm -r --if-present test",
    "openapi": "pnpm --filter @fmv/server openapi",
    "dev:web": "pnpm --filter @fmv/web dev",
    "local:setup": "node infra/scripts/local.mjs setup",
    "local:up": "node infra/scripts/local.mjs up",
    "local:down": "node infra/scripts/local.mjs down",
    "local:status": "node infra/scripts/local.mjs status",
    "db:migrate": "node infra/scripts/local.mjs migrate",
    "db:status": "node infra/scripts/local.mjs db-status",
    "db:migration": "node infra/scripts/local.mjs migration",
    "test:db": "node infra/scripts/local.mjs test",
    "test:infra": "node --test infra/test/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
