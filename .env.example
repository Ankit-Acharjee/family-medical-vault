# Server-only development settings. Copy to ignored .env and chmod 600 .env.
# Keep disabled until the dedicated runtime DB role and migrations are ready.
AUTH_ENABLED=false
AUTH_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_locally
AUTH_SESSION_KEY=replace_with_64_random_hex_characters
DATABASE_URL=postgresql://fmv_app:replace_locally@your-db-host:5432/postgres?sslmode=verify-full
DATABASE_MIGRATION_URL=postgresql://migration_owner:replace_locally@your-db-host:5432/postgres?sslmode=verify-full&schema=fmv

# Server-only private development R2. Never use VITE_ prefixes or public URLs.
# Apply the object-generation migration before enabling storage.
R2_ENABLED=false
R2_ACCOUNT_ID=replace_with_cloudflare_account_id
R2_BUCKET=family-medical-vault-dev
R2_ACCESS_KEY_ID=replace_locally
R2_SECRET_ACCESS_KEY=replace_locally
