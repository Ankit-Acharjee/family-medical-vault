// Keep application data separate from provider-managed Supabase Auth schemas.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["fmv"]
}

// These are internal backend sessions, never patient identities or grants.
model AuthSession {
  idHash    String   @id @map("id_hash")
  userId    String?  @map("user_id")
  payload   String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("fmv")
}

model AuthRateLimit {
  id        String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
  @@schema("fmv")
}

model AppAccount {
 activationIssued ProfileActivation[] @relation("ActivationIssuer")
 activationClaims ProfileActivation[] @relation("ActivationClaimant")
 activationTransitions ProfileActivation[] @relation("ActivationTransition")
 profileActivationEvents ProfileActivationEvent[]
 managedCreations ManagedProfileCreation[]
 emergencyEntries EmergencyProfileEntry[]
 emergencyEvents EmergencyProfileEvent[]
  createdTemporaryLinks TemporaryLink[] @relation("TemporaryLinkCreator")
  revokedTemporaryLinks TemporaryLink[] @relation("TemporaryLinkRevoker")
  summaryExports SummaryExportEvent[]
 medicationSchedules MedicationSchedule[]
 medicationScheduleEvents MedicationScheduleEvent[]
 medicationInventory MedicationInventory[]
 medicationInventoryEvents MedicationInventoryEvent[]
  medicationReconciliations MedicationReconciliation[]
  medicationReconciliationEvents MedicationReconciliationEvent[]
  manualMeasurements ManualMeasurement[]
  manualEvents ManualMeasurementEvent[]
  id                  String                     @id @db.Uuid
  issuer              String
  subject             String
  person              Person?
  receivedGrants      AccessGrant[]              @relation("GrantRecipient")
  issuedGrants        AccessGrant[]              @relation("GrantIssuer")
  accessEvents        AccessEvent[]
  documentEvents      DocumentEvent[]
  savedExtractions    DocumentExtraction[]
  savedMetadata       DocumentMetadataSnapshot[]
  clinicalReviews     DocumentClinicalReview[]
  processingConsents  DocumentProcessingConsent[]
  medicationReviews   DocumentMedicationReview[]
  diagnosisReviews    DocumentDiagnosisReview[]
  issuedInvitations   AccessInvitation[]         @relation("InvitationIssuer")
  receivedInvitations AccessInvitation[]         @relation("InvitationRecipient")

  @@unique([issuer, subject], map: "app_accounts_provider_key")
  @@map("app_accounts")
  @@schema("fmv")
}

model Person {
 activations ProfileActivation[]
 activationEvents ProfileActivationEvent[]
 managedCreation ManagedProfileCreation?
 emergencyEntries EmergencyProfileEntry[]
 emergencyEvents EmergencyProfileEvent[]
  temporaryLinks TemporaryLink[]
  summaryExports SummaryExportEvent[]
  manualMeasurements ManualMeasurement[]
  id               String             @id @db.Uuid
  storageNamespace String             @unique @default(dbgenerated("gen_random_uuid()")) @map("storage_namespace") @db.Uuid
  ownerAccountId   String?            @unique @map("owner_account_id") @db.Uuid
  displayName      String             @map("display_name")
  account          AppAccount?        @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)
  grants           AccessGrant[]
  accessEvents     AccessEvent[]
  documents        Document[]
  documentEvents   DocumentEvent[]
  invitations      AccessInvitation[]

  @@map("persons")
  @@schema("fmv")
}

model AccessGrant {
 managedCreation ManagedProfileCreation?
  id                 String                  @id @db.Uuid
  patientId          String                  @map("patient_id") @db.Uuid
  granteeAccountId   String                  @map("grantee_account_id") @db.Uuid
  issuerAccountId    String                  @map("issuer_account_id") @db.Uuid
  actions            String[]
  scopeKind          String                  @map("scope_kind")
  categoryId         String?                 @map("category_id") @db.Uuid
  documentId         String?                 @map("document_id") @db.Uuid
  expiresAt          DateTime?               @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?               @map("revoked_at") @db.Timestamptz(3)
  createdAt          DateTime                @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(3)
  patient            Person                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  grantee            AppAccount              @relation("GrantRecipient", fields: [granteeAccountId], references: [id], onDelete: Restrict)
  issuer             AppAccount              @relation("GrantIssuer", fields: [issuerAccountId], references: [id], onDelete: Restrict)
  events             AccessEvent[]
  parentDependencies AccessGrantDependency[] @relation("DependencyChild")
  childDependencies  AccessGrantDependency[] @relation("DependencyParent")
  category           DocumentCategory?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  document           Document?               @relation(fields: [patientId, documentId], references: [patientId, id], onDelete: Restrict)

  @@unique([patientId, id], map: "access_grants_patient_identity")
  @@index([patientId, granteeAccountId], map: "access_grants_lookup")
  @@index([granteeAccountId], map: "access_grants_recipient")
  @@map("access_grants")
  @@schema("fmv")
}

model DocumentCategory {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String        @unique
  name      String
  documents Document[]
  grants    AccessGrant[]

  @@map("document_categories")
  @@schema("fmv")
}

model AccessGrantDependency {
  patientId     String      @map("patient_id") @db.Uuid
  grantId       String      @map("grant_id") @db.Uuid
  parentGrantId String      @map("parent_grant_id") @db.Uuid
  child         AccessGrant @relation("DependencyChild", fields: [patientId, grantId], references: [patientId, id], onDelete: Restrict)
  parent        AccessGrant @relation("DependencyParent", fields: [patientId, parentGrantId], references: [patientId, id], onDelete: Restrict)

  @@id([grantId, parentGrantId])
  @@map("access_grant_dependencies")
  @@schema("fmv")
}

model AccessInvitation {
  id                 String      @id @db.Uuid
  tokenHash          String      @unique @map("token_hash")
  kind               String
  patientId          String?     @map("patient_id") @db.Uuid
  issuerAccountId    String      @map("issuer_account_id") @db.Uuid
  recipientAccountId String?     @map("recipient_account_id") @db.Uuid
  actions            String[]
  scopeKind          String      @map("scope_kind")
  categoryId         String?     @map("category_id") @db.Uuid
  documentId         String?     @map("document_id") @db.Uuid
  state              String
  createdAt          DateTime    @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(3)
  expiresAt          DateTime    @map("expires_at") @db.Timestamptz(3)
  patient            Person?     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  issuer             AppAccount  @relation("InvitationIssuer", fields: [issuerAccountId], references: [id], onDelete: Restrict)
  recipient          AppAccount? @relation("InvitationRecipient", fields: [recipientAccountId], references: [id], onDelete: Restrict)

  @@index([patientId], map: "access_invitations_patient")
  @@map("access_invitations")
  @@schema("fmv")
}

model Document {
  temporaryLinkAccess TemporaryLinkAccessEvent[]
  medicationReconciliations MedicationReconciliation[]
  id                  String                    @id @db.Uuid
  uploadId            String                    @unique @map("upload_id") @db.Uuid
  patientId           String                    @map("patient_id") @db.Uuid
  categoryId          String                    @map("category_id") @db.Uuid
  title               String
  displayTitle        String?                   @map("display_title")
  deletedAt           DateTime?                 @map("deleted_at") @db.Timestamptz(3)
  extractionLifecycle Int                       @default(0) @map("extraction_lifecycle")
  mimeType            String                    @map("mime_type")
  bytes               Int
  sha256              String
  idempotencyKey      String                    @map("idempotency_key")
  objectKey           String                    @unique @map("object_key")
  state               String
  createdAt           DateTime                  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(3)
  patient             Person                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  category            DocumentCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  grants              AccessGrant[]
  events              DocumentEvent[]
  clinicalReviews     DocumentClinicalReview[]
  processingConsents  DocumentProcessingConsent[]
  medicationReviews   DocumentMedicationReview[]
  diagnosisReviews    DocumentDiagnosisReview[]
  metadataSnapshot    DocumentMetadataSnapshot?
  extraction          DocumentExtraction?
  objects             DocumentObjectAttempt[]   @relation("DocumentObjects")
  currentObject       DocumentObjectAttempt     @relation("CurrentObject", fields: [id, objectKey], references: [documentId, objectKey], onDelete: Restrict)

  @@unique([patientId, idempotencyKey])
  @@unique([patientId, id], map: "documents_patient_identity")
  @@index([patientId, createdAt], map: "documents_patient")
  @@map("documents")
  @@schema("fmv")
}

model DocumentObjectAttempt {
  objectKey  String     @id @map("object_key")
  documentId String     @map("document_id") @db.Uuid
  createdAt  DateTime   @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(3)
  retiredAt  DateTime?  @map("retired_at") @db.Timestamptz(3)
  document   Document   @relation("DocumentObjects", fields: [documentId], references: [id], onDelete: Restrict)
  currentFor Document[] @relation("CurrentObject")

  @@unique([documentId, objectKey], map: "document_object_attempts_identity")
  @@index([documentId], map: "document_object_attempts_document")
  @@map("document_object_attempts")
  @@schema("fmv")
}

model DocumentEvent {
  id             String     @id @db.Uuid
  patientId      String     @map("patient_id") @db.Uuid
  documentId     String     @map("document_id") @db.Uuid
  actorAccountId String     @map("actor_account_id") @db.Uuid
  kind           String
  occurredAt     DateTime   @default(dbgenerated("statement_timestamp()")) @map("occurred_at") @db.Timestamptz(3)
  retentionUntil DateTime   @default(dbgenerated("(statement_timestamp() + interval '90 days')")) @map("retention_until") @db.Timestamptz(3)
  patient        Person     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  document       Document   @relation(fields: [documentId], references: [id], onDelete: Restrict)
  actor          AppAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt(sort: Desc), id(sort: Desc)], map: "document_events_patient_time")
  @@index([retentionUntil], map: "document_events_retention")
  @@map("document_events")
  @@schema("fmv")
}

model AccessEvent {
  id             String       @id @db.Uuid
  patientId      String       @map("patient_id") @db.Uuid
  actorAccountId String       @map("actor_account_id") @db.Uuid
  kind           String
  grantId        String?      @map("grant_id") @db.Uuid
  occurredAt     DateTime     @default(dbgenerated("statement_timestamp()")) @map("occurred_at") @db.Timestamptz(3)
  patient        Person       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  actor          AppAccount   @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)
  grant          AccessGrant? @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@index([patientId, occurredAt(sort: Desc), id(sort: Desc)], map: "access_events_patient_time")
  @@map("access_events")
  @@schema("fmv")
}

model DocumentExtraction {
  documentId       String     @id @map("document_id") @db.Uuid
  patientId        String     @map("patient_id") @db.Uuid
  sourceSha256     String     @map("source_sha256")
  lifecycleVersion Int        @map("lifecycle_version")
  revision         Int
  requestId        String     @map("request_id") @db.Uuid
  payloadHash      String     @map("payload_hash")
  actorAccountId   String     @map("actor_account_id") @db.Uuid
  result           Json       @db.JsonB
  /// Stored generated column owned by the reviewed SQL migration. Never write directly.
  searchTerms      String[]   @default(dbgenerated()) @map("search_terms")
  savedAt          DateTime   @default(dbgenerated("clock_timestamp()")) @map("saved_at") @db.Timestamptz(3)
  document         Document   @relation(fields: [patientId, documentId], references: [patientId, id], onDelete: Cascade)
  actor            AppAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@unique([patientId, documentId])
  @@index([searchTerms], type: Gin, map: "document_extractions_search_terms_idx")
  @@map("document_extractions")
  @@schema("fmv")
}

model DocumentMetadataSnapshot {
  documentId       String     @id @map("document_id") @db.Uuid
  patientId        String     @map("patient_id") @db.Uuid
  sourceRevision   Int        @map("source_revision")
  sourceSha256     String     @map("source_sha256")
  lifecycleVersion Int        @map("lifecycle_version")
  revision         Int
  requestId        String     @map("request_id") @db.Uuid
  payloadHash      String     @map("payload_hash")
  actorAccountId   String     @map("actor_account_id") @db.Uuid
  ruleVersion      String     @map("rule_version")
  suggestions      Json       @db.JsonB
  savedAt          DateTime   @default(dbgenerated("clock_timestamp()")) @map("saved_at") @db.Timestamptz(3)
  document         Document   @relation(fields: [patientId, documentId], references: [patientId, id], onDelete: Cascade)
  actor            AppAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@unique([patientId, documentId])
  @@map("document_metadata_snapshots")
  @@schema("fmv")
}

model DocumentClinicalReview {
  action           String     @default("confirmation")
  withdrawnItems   Json       @default("[]") @map("withdrawn_items") @db.JsonB
  id               String     @id @db.Uuid
  documentId       String     @map("document_id") @db.Uuid
  patientId        String     @map("patient_id") @db.Uuid
  revision         Int
  sourceRevision   Int        @map("source_revision")
  sourceSha256     String     @map("source_sha256")
  lifecycleVersion Int        @map("lifecycle_version")
  requestId        String     @map("request_id") @db.Uuid
  payloadHash      String     @map("payload_hash")
  actorAccountId   String     @map("actor_account_id") @db.Uuid
  ruleVersion      String     @default("labeled-lab-blocks-v1") @map("rule_version")
  sourceContext    Json       @map("source_context") @db.JsonB
  items            Json       @db.JsonB
  verifiedAt       DateTime   @default(dbgenerated("clock_timestamp()")) @map("verified_at") @db.Timestamptz(3)
  document         Document   @relation(fields: [patientId, documentId], references: [patientId, id], onDelete: Cascade)
  actor            AppAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@unique([documentId, revision])
  @@unique([documentId, requestId])
  @@map("document_clinical_reviews")
  @@schema("fmv")
}

model DocumentDiagnosisReview {
  id                  String     @id @db.Uuid
  documentId          String     @map("document_id") @db.Uuid
  patientId           String     @map("patient_id") @db.Uuid
  revision            Int
  sourceRevision      Int        @map("source_revision")
  sourceSha256        String     @map("source_sha256")
  lifecycleVersion    Int        @map("lifecycle_version")
  requestId           String     @map("request_id") @db.Uuid
  payloadHash         String     @map("payload_hash")
  actorAccountId      String     @map("actor_account_id") @db.Uuid
  ruleVersion         String     @default("explicit-diagnosis-lines-v1") @map("rule_version")
  meaning             String     @default("source-statement-only")
  sourceContext       Json       @map("source_context") @db.JsonB
  action              String
  statements          Json       @db.JsonB
  withdrawnStatements Json       @default("[]") @map("withdrawn_statements") @db.JsonB
  confirmedAt         DateTime   @default(dbgenerated("clock_timestamp()")) @map("confirmed_at") @db.Timestamptz(3)
  document            Document   @relation(fields: [patientId, documentId], references: [patientId, id], onDelete: Cascade)
  actor               AppAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@unique([documentId, revision])
  @@unique([documentId, requestId])
  @@map("document_diagnosis_reviews")
  @@schema("fmv")
}

model DocumentMedicationReview {
  id                  String     @id @db.Uuid
  documentId          String     @map("document_id") @db.Uuid
  patientId           String     @map("patient_id") @db.Uuid
  revision            Int
  sourceRevision      Int        @map("source_revision")
  sourceSha256        String     @map("source_sha256")
  lifecycleVersion    Int        @map("lifecycle_version")
  requestId           String     @map("request_id") @db.Uuid
  payloadHash         String     @map("payload_hash")
  actorAccountId      String     @map("actor_account_id") @db.Uuid
  ruleVersion         String     @default("labeled-medication-blocks-v1") @map("rule_version")
  meaning             String     @default("source-fields-only")
  sourceContext       Json       @map("source_context") @db.JsonB
  action              String
  statements          Json       @db.JsonB
  withdrawnStatements Json       @default("[]") @map("withdrawn_statements") @db.JsonB
  confirmedAt         DateTime   @default(dbgenerated("clock_timestamp()")) @map("confirmed_at") @db.Timestamptz(3)
  document            Document   @relation(fields: [patientId, documentId], references: [patientId, id], onDelete: Cascade)
  actor               AppAccount @relation(fields: [actorAccountId], references: [id], onDelete: Restrict)

  @@unique([documentId, revision])
  @@unique([documentId, requestId])
  @@map("document_medication_reviews")
  @@schema("fmv")
}

model ProcessingProviderRecord {
  generation String @id @db.Uuid
  providerId String @map("provider_id")
  policyVersion String @map("policy_version")
  purposes String[]
  dataCategories String[] @map("data_categories")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  reviewReference String @map("review_reference")
  enabled Boolean @default(false)
  reviewedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("reviewed_at") @db.Timestamptz(3)
  consents DocumentProcessingConsent[]
  @@unique([providerId,policyVersion])
  @@map("processing_provider_policies")
  @@schema("fmv")
}
model DocumentProcessingConsent {
  id String @id @db.Uuid
  documentId String @map("document_id") @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  revision Int
  requestId String @map("request_id") @db.Uuid
  payloadHash String @map("payload_hash")
  actorAccountId String @map("actor_account_id") @db.Uuid
  action String
  sourceSha256 String @map("source_sha256")
  sourceRevision Int @map("source_revision")
  lifecycleVersion Int @map("lifecycle_version")
  policyGeneration String @map("policy_generation") @db.Uuid
  providerId String @map("provider_id")
  policyVersion String @map("policy_version")
  purpose String
  dataCategories String[] @map("data_categories")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
  document Document @relation(fields:[patientId,documentId],references:[patientId,id],onDelete:Cascade)
  actor AppAccount @relation(fields:[actorAccountId],references:[id],onDelete:Restrict)
  policy ProcessingProviderRecord @relation(fields:[policyGeneration],references:[generation],onDelete:Restrict)
  @@unique([documentId,revision])
  @@unique([documentId,requestId])
  @@map("document_processing_consents")
  @@schema("fmv")
}

model ManualMeasurement {
 id String @id @db.Uuid
 readingId String @map("reading_id") @db.Uuid
 patientId String @map("patient_id") @db.Uuid
 revision Int
 action String
 requestId String @map("request_id") @db.Uuid
 payloadHash String @map("payload_hash")
 actorAccountId String @map("actor_account_id") @db.Uuid
 reading Json
 recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
 patient Person @relation(fields:[patientId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 actor AppAccount @relation(fields:[actorAccountId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 events ManualMeasurementEvent[]
 @@unique([readingId,revision])
 @@unique([readingId,requestId])
 @@unique([patientId,readingId,id])
 @@index([patientId,readingId,revision(sort:Desc)],map:"manual_measurements_patient_latest")
 @@map("manual_measurements")
 @@schema("fmv")
}
model ManualMeasurementEvent {
 id String @id @db.Uuid
 patientId String @map("patient_id") @db.Uuid
 readingId String @map("reading_id") @db.Uuid
 entryId String @map("entry_id") @db.Uuid
 actorAccountId String @map("actor_account_id") @db.Uuid
 kind String
 recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
 expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
 entry ManualMeasurement @relation(fields:[patientId,readingId,entryId],references:[patientId,readingId,id],onDelete:Cascade,onUpdate:NoAction)
 actor AppAccount @relation(fields:[actorAccountId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 @@map("manual_measurement_events")
 @@schema("fmv")
}

model MedicationReconciliation {
 schedules MedicationSchedule[]
 inventory MedicationInventory[]
 sourceRecords MedicationSourceRecord[]
 id String @id @db.Uuid
 medicationId String @map("medication_id") @db.Uuid
 patientId String @map("patient_id") @db.Uuid
 documentId String @map("document_id") @db.Uuid
 candidateId String @map("candidate_id")
 sourceRevision Int @map("source_revision")
 sourceSha256 String @map("source_sha256")
 lifecycleVersion Int @map("lifecycle_version")
 reviewRevision Int @map("review_revision")
 revision Int
 action String
 recordedStatus String @map("recorded_status")
 fields Json
 requestId String @map("request_id") @db.Uuid
 payloadHash String @map("payload_hash")
 actorAccountId String @map("actor_account_id") @db.Uuid
 recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
 document Document @relation(fields:[patientId,documentId],references:[patientId,id],onDelete:Cascade,onUpdate:NoAction)
 actor AppAccount @relation(fields:[actorAccountId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 events MedicationReconciliationEvent[]
 @@unique([medicationId,revision])
 @@unique([medicationId,requestId])
 @@unique([patientId,medicationId,id])
 @@index([patientId,medicationId,revision(sort:Desc)],map:"medication_reconciliations_latest")
 @@map("medication_reconciliations")
 @@schema("fmv")
}
model MedicationReconciliationEvent {
 id String @id @db.Uuid
 patientId String @map("patient_id") @db.Uuid
 medicationId String @map("medication_id") @db.Uuid
 entryId String @map("entry_id") @db.Uuid
 actorAccountId String @map("actor_account_id") @db.Uuid
 kind String
 recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
 expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
 entry MedicationReconciliation @relation(fields:[patientId,medicationId,entryId],references:[patientId,medicationId,id],onDelete:Cascade,onUpdate:NoAction)
 actor AppAccount @relation(fields:[actorAccountId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 @@map("medication_reconciliation_events")
 @@schema("fmv")
}

model MedicationSourceRecord {
 patientId String @map("patient_id") @db.Uuid
 documentId String @map("document_id") @db.Uuid
 sourceRevision Int @map("source_revision")
 lifecycleVersion Int @map("lifecycle_version")
 candidateId String @map("candidate_id")
 sourceSha256 String @map("source_sha256")
 medicationId String @map("medication_id") @db.Uuid
 firstEntryId String @map("first_entry_id") @db.Uuid
 entry MedicationReconciliation @relation(fields:[patientId,medicationId,firstEntryId],references:[patientId,medicationId,id],onDelete:Cascade,onUpdate:NoAction)
 @@id([patientId,documentId,sourceRevision,lifecycleVersion,candidateId])
 @@index([patientId,medicationId,firstEntryId],map:"medication_source_records_entry")
 @@map("medication_source_records")
 @@schema("fmv")
}

model MedicationInventory {
 id String @id @db.Uuid
 patientId String @map("patient_id") @db.Uuid
 medicationId String @map("medication_id") @db.Uuid
 medicationEntryId String @map("medication_entry_id") @db.Uuid
 medicationRevision Int @map("medication_revision")
 revision Int
 fields Json
 requestId String @map("request_id") @db.Uuid
 payloadHash String @map("payload_hash")
 actorAccountId String @map("actor_account_id") @db.Uuid
 recordedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("recorded_at") @db.Timestamptz(3)
 medication MedicationReconciliation @relation(fields:[patientId,medicationId,medicationEntryId],references:[patientId,medicationId,id],onDelete:Cascade,onUpdate:NoAction)
 actor AppAccount @relation(fields:[actorAccountId],references:[id],onDelete:NoAction,onUpdate:NoAction)
 events MedicationInventoryEvent[]
 @@unique([medicationId,revision])
 @@unique([medicationId,requestId])
 @@unique([patientId,medicationId,id])
 @@index([patientId,medicationId,revision(sort:Desc)],map:"medication_inventory_latest")
 @@map("medication_inventory")
 @@schema("fmv")
}
model MedicationInventoryEvent {
 id String @id @db.Uuid
 patientId String @map("patient_id") @db.Uuid
 medicationId String @map("medication_id") @db.Uuid
 entryId String @map("entry_id") @db.Uuid
