// Keep application data separate from provider-managed Supabase Auth schemas.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["fmv"]
}

// These are internal backend sessions, never patient identities or grants.
model AuthSession {
  idHash    String   @id @map("id_hash")
  userId    String?  @map("user_id")
  payload   String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("fmv")
}

model AuthRateLimit {
  id        String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_rate_limits")
  @@schema("fmv")
}

model AppAccount {
  id      String  @id @db.Uuid
  issuer  String
  subject String
  person  Person?

  @@unique([issuer, subject], map: "app_accounts_provider_key")
  @@map("app_accounts")
  @@schema("fmv")
}

model Person {
  id             String     @id @db.Uuid
  ownerAccountId String     @unique @map("owner_account_id") @db.Uuid
  displayName    String     @map("display_name")
  account        AppAccount @relation(fields: [ownerAccountId], references: [id], onDelete: Restrict)

  @@map("persons")
  @@schema("fmv")
}
