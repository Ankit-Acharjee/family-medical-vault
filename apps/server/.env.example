# Export in your shell; environment files are not loaded automatically.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development

# Future runtime uses a restricted application role. No credentials belong here.
DATABASE_URL=
# Migration credentials are separate, available only to approved migration runners.
DATABASE_MIGRATION_URL=
# Optional private R2 settings belong in the restricted root .env; see ../../.env.example.
