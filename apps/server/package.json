{
  "name": "@fmv/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @fmv/contracts build && pnpm db:generate && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @fmv/contracts build && pnpm db:generate && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "start": "node dist/main.js",
    "dev": "node --env-file-if-exists=../../.env --run dev:watch",
    "test": "pnpm build && node --test test/*.test.mjs",
    "openapi": "pnpm build && node dist/generate-openapi.js",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:migration": "prisma migrate dev --create-only",
    "test:db": "node --test test/integration/*.test.mjs",
    "db:generate": "prisma generate",
    "dev:watch": "pnpm --filter @fmv/contracts build && pnpm db:generate && tsc-watch -p tsconfig.json --onSuccess \"node dist/main.js\""
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@fmv/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "tsc-watch": "7.2.1"
  }
}
